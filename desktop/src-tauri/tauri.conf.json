{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JarvGenie",
  "version": "0.1.0",
  "identifier": "ai.jarvgenie.desktop",
  "build": {
    "frontendDist": "../ui-dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jarv Genie",
        "width": 920,
        "height": 720,
        "minWidth": 480,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:3001; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"]
  }
}
