{
  "name": "jarv-genie",
  "version": "0.1.0",
  "description": "Jarv Genie - a standalone, local-first personal AI assistant that runs on your own devices.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "jarv-genie": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "doctor": "npm run build && node dist/index.js --doctor"
  },
  "keywords": [
    "ai",
    "assistant",
    "agent",
    "llm",
    "jarvis",
    "mcp",
    "local-first",
    "personal"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openai": "^7.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
